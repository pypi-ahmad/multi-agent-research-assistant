# Copy this file to .env and fill in your own values.
# If OPENAI_API_KEY / OPENAI_BASE_URL are already set as system/user
# environment variables on your machine, this file is not required -
# python-dotenv never overrides variables that already exist in the
# environment.

# OpenAI-compatible endpoint used for planning, critique, and final synthesis
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Alternative OpenAI-compatible reasoning backend, selectable in the UI
AGNES_API_KEY=...
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# Local Ollama server used for cheap researcher-side summarization
OLLAMA_BASE_URL=http://localhost:11434
